<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>

<main class="container py-5">
  <!-- Tiêu đề và giới thiệu -->
  <section class="mb-5">
    <h1 class="fw-bold mb-3">Trung tâm hỗ trợ</h1>
    <p class="text-muted">
      Chọn chủ đề bạn cần hỗ trợ, chúng tôi sẽ phản hồi trong thời gian sớm nhất.
    </p>
  </section>

  <!-- Các chủ đề hỗ trợ -->
  <section class="row g-4 align-items-stretch">
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Đơn hàng & giao hàng</h2>
        <p class="text-muted mb-0">
          Theo dõi trạng thái đơn hàng, thời gian giao hàng và phí vận chuyển.
        </p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Đổi trả & bảo hành</h2>
        <p class="text-muted mb-0">
          Hướng dẫn đổi trả, hoàn tiền và chính sách bảo hành sản phẩm.
        </p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Tài khoản & bảo mật</h2>
        <p class="text-muted mb-0">
          Cập nhật thông tin, đổi mật khẩu và bảo mật tài khoản.
        </p>
      </div>
    </div>
  </section>

  <!-- Liên hệ nhanh -->
  <section class="mt-5">
    <div class="hero-card p-4 p-lg-5 rounded-4">
      <h2 class="h4 fw-semibold mb-3">Liên hệ nhanh</h2>
      <p class="text-muted mb-4">
        Nếu cần hỗ trợ ngay, vui lòng liên hệ qua các kênh bên dưới.
      </p>
      <div class="d-flex flex-wrap gap-3">
        <div class="text-muted">Hotline: 0900 000 000</div>
        <div class="text-muted">Email: support@vantruyen.com</div>
      </div>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
