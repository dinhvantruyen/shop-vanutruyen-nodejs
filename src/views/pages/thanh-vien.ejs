<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>

<main class="container py-5">
  <!-- Tiêu đề và mô tả trang -->
  <section class="mb-4">
    <h1 class="fw-bold mb-2">Bảng xếp hạng thành viên</h1>
    <p class="text-muted mb-0">
      Sắp xếp theo số đơn hàng đã mua nhiều nhất.
    </p>
  </section>

  <!-- Bảng danh sách thành viên -->
  <section class="hero-card p-4 rounded-4">
    <% if (!users || users.length === 0) { %>
      <div class="alert alert-warning mb-0">Chưa có thành viên nào.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0 text-center">
          <thead>
            <tr>
              <th>#</th>
              <th>Khách hàng</th>
              <th>Email</th>
              <th>Số đơn hàng</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td><strong><%= user.purchaseCount || 0 %></strong></td>
                <td>
                  <% if (user.isActive) { %>
                    <span class="badge text-bg-success">Hoạt động</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary">Tạm khóa</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include("../partials/footer") %>
