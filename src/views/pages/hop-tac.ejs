<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>

<main class="container py-5">
  <!-- Tiêu đề và giới thiệu -->
  <section class="mb-5">
    <h1 class="fw-bold mb-3">Hợp tác cùng Vantruyen</h1>
    <p class="text-muted">
      Chúng tôi tìm kiếm đối tác phân phối, nhà cung cấp và cộng sự sáng tạo
      để mở rộng hệ sinh thái thời trang bền vững.
    </p>
  </section>

  <!-- Các hình thức hợp tác -->
  <section class="row g-4 align-items-stretch">
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Đại lý phân phối</h2>
        <p class="text-muted mb-0">
          Đồng hành cùng Vantruyen để đưa sản phẩm đến nhiều khách hàng hơn.
        </p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Nhà cung cấp</h2>
        <p class="text-muted mb-0">
          Kết nối chất liệu và sản xuất để đảm bảo chất lượng ổn định.
        </p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="hero-card p-4 rounded-4 h-100">
        <h2 class="h5 fw-semibold mb-3">Cộng sự sáng tạo</h2>
        <p class="text-muted mb-0">
          Thiết kế bộ sưu tập mới, truyền cảm hứng cho khách hàng trẻ.
        </p>
      </div>
    </div>
  </section>

  <!-- Thông tin liên hệ -->
  <section class="mt-5">
    <div class="hero-card p-4 p-lg-5 rounded-4">
      <h2 class="h4 fw-semibold mb-3">Liên hệ hợp tác</h2>
      <p class="text-muted mb-4">
        Gửi thông tin doanh nghiệp và đề xuất hợp tác, chúng tôi sẽ phản hồi
        trong 24-48 giờ làm việc.
      </p>
      <div class="d-flex flex-wrap gap-3">
        <div class="text-muted">Email: partnership@vantruyen.com</div>
        <div class="text-muted">Hotline: 0900 000 000</div>
      </div>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
