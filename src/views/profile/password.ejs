<%- include("../partials/head", { title }) %>
  <%- include("../partials/header") %>

    <!-- Trang đổi mật khẩu -->
    <main class="container py-5">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h1 class="h4 mb-2">Thay đổi mật khẩu</h1>
          <p class="text-muted mb-3">Bảo mật tài khoản bằng mật khẩu mạnh.</p>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-dark" href="/profile">Thông tin cá nhân</a>
            <a class="btn btn-outline-dark" href="/profile/orders">Theo dõi đơn hàng</a>
            <a class="btn btn-dark" href="/profile/password">Thay đổi mật khẩu</a>
            <a class="btn btn-outline-dark" href="/profile/address">Cập nhật địa chỉ</a>
          </div>
          <!-- Thông báo lỗi/thành công -->
          <% if (error) { %>
            <div class="alert alert-danger mt-3 mb-0">
              <%= error %>
            </div>
            <% } %>
              <% if (success) { %>
                <div class="alert alert-success mt-3 mb-0">
                  <%= success %>
                </div>
                <% } %>
        </div>
      </div>

      <!-- Form cập nhật mật khẩu -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted">Thông tin mật khẩu</h2>
          <!-- Gửi request đổi mật khẩu -->
          <form method="post" action="/profile/password">
            <div class="mb-3">
              <label class="form-label">Mật khẩu hiện tại</label>
              <input class="form-control" name="currentPassword" type="password" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Mật khẩu mới</label>
              <input class="form-control" name="newPassword" type="password" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Nhập lại mật khẩu mới</label>
              <input class="form-control" name="confirmPassword" type="password" required />
            </div>
            <button class="btn btn-dark" type="submit">Đổi mật khẩu</button>
          </form>
        </div>
      </div>
    </main>

    <%- include("../partials/footer") %>