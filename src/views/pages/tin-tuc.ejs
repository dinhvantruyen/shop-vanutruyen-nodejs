<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>

<main class="container py-5">
  <!-- Tiêu đề và giới thiệu -->
  <section class="mb-5">
    <h1 class="fw-bold mb-3">Tin tức</h1>
    <p class="text-muted">
      Cập nhật xu hướng thời trang, mẹo phối đồ và thông tin mới nhất từ Vantruyen.
    </p>
  </section>

  <!-- Danh sách bài viết -->
  <section class="row g-4">
    <div class="col-lg-4">
      <article class="hero-card p-4 rounded-4 h-100">
        <span class="badge text-bg-dark mb-3">Xu hướng</span>
        <h2 class="h5 fw-semibold mb-3">Phong cách tối giản năm 2025</h2>
        <p class="text-muted mb-4">
          Gam màu trung tính, chất liệu co giãn và form dáng dễ mặc.
        </p>
        <a class="btn btn-outline-dark btn-sm" href="#">Đọc tiếp</a>
      </article>
    </div>
    <div class="col-lg-4">
      <article class="hero-card p-4 rounded-4 h-100">
        <span class="badge text-bg-dark mb-3">Góc phối đồ</span>
        <h2 class="h5 fw-semibold mb-3">5 combo dễ mặc cho mỗi ngày</h2>
        <p class="text-muted mb-4">
          Từ công sở đến đi chơi, chỉ cần thay đổi 1 chi tiết.
        </p>
        <a class="btn btn-outline-dark btn-sm" href="#">Đọc tiếp</a>
      </article>
    </div>
    <div class="col-lg-4">
      <article class="hero-card p-4 rounded-4 h-100">
        <span class="badge text-bg-dark mb-3">Cập nhật</span>
        <h2 class="h5 fw-semibold mb-3">Bộ sưu tập mới đã lên kệ</h2>
        <p class="text-muted mb-4">
          Khám phá những mẫu thiết kế mới nhất từ Vantruyen.
        </p>
        <a class="btn btn-outline-dark btn-sm" href="#">Đọc tiếp</a>
      </article>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
