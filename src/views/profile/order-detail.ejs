<%- include("../partials/head", { title }) %>
  <%- include("../partials/header") %>

    <!-- Trang chi tiết đơn hàng -->
    <main class="container py-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 mb-0">Chi tiết đơn hàng</h1>
        <a class="btn btn-outline-dark btn-sm" href="/profile/orders">Quay lại</a>
      </div>

      <!-- Thông tin tổng quan đơn hàng -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="text-muted">Mã đơn</div>
              <div class="fw-semibold">
                <%= order._id.toString().slice(-6).toUpperCase() %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted">Ngày đặt</div>
              <div class="fw-semibold">
                <%= new Date(order.createdAt).toLocaleDateString("vi-VN") %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted">Trạng thái</div>
              <div class="fw-semibold">
                <%= order.status %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Thông tin giao hàng -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted">Thông tin giao hàng</h2>
          <div class="mt-3">
            <div><strong>Người nhận:</strong>
              <%= order.shippingInfo.receiverName || "-" %>
            </div>
            <div><strong>Số điện thoại:</strong>
              <%= order.shippingInfo.phone || "-" %>
            </div>
            <div><strong>Tỉnh/Thành phố:</strong>
              <%= order.shippingInfo.city || "-" %>
            </div>
            <div><strong>Phường/Xã:</strong>
              <%= order.shippingInfo.ward || "-" %>
            </div>
            <div><strong>Địa chỉ:</strong>
              <%= order.shippingInfo.address || "-" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Danh sách sản phẩm và tổng tiền -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted">Sản phẩm</h2>
          <!-- Lặp qua sản phẩm trong đơn -->
          <% order.items.forEach((item)=> { %>
            <div class="d-flex justify-content-between align-items-center border-bottom py-3">
              <div>
                <div class="fw-semibold">
                  <%= item.name %>
                </div>
                <div class="text-muted">
                  <% if (item.size) { %>Size: <%= item.size %>
                      <% } %>
                        <% if (item.color) { %> | Màu: <%= item.color %>
                            <% } %>
                </div>
              </div>
              <div class="text-end">
                <div>
                  <%= item.price.toLocaleString("vi-VN") %> VND
                </div>
                <div class="text-muted">x<%= item.quantity %>
                </div>
              </div>
            </div>
            <% }) %>

              <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="fw-semibold">Tổng cộng</span>
                <strong>
                  <%= order.total.toLocaleString("vi-VN") %> VND
                </strong>
              </div>
        </div>
      </div>
    </main>

    <%- include("../partials/footer") %>