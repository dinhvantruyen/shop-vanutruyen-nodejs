<%- include("../partials/head", { title }) %>
  <%- include("../partials/header") %>

    <main class="new-page">
      <!-- Khối trang sản phẩm mới -->
      <div class="container new-shell">
        <!-- Tiêu đề + mô tả -->
        <div class="new-head new-head--center">
          <div>
            <h1>Sản phẩm mới nhất</h1>
            <p class="text-muted">Khám phá những sản phẩm vừa được cập nhật tại cửa hàng.</p>
          </div>
        </div>

        <!-- Bố cục lọc bên trái + danh sách sản phẩm bên phải -->
        <div class="new-layout">
          <!-- Khối bộ lọc -->
          <aside class="filters">
            <div class="filters-header">Bộ lọc sản phẩm</div>
            <div class="filter-section">
              <div class="filter-title">Danh mục</div>
              <ul class="filter-list">
                <% categories
                  .filter((category) => category.parent && category.isActive !== false)
                  .forEach((category) => { %>
                  <li>
                    <label>
                      <input type="checkbox" class="filter-category" value="<%= category._id %>" />
                      <span>
                        <%= category.name %>
                      </span>
                    </label>
                  </li>
                  <% }) %>
              </ul>
            </div>
            <div class="filter-section">
              <div class="filter-title">Giá</div>
              <ul class="filter-list">
                <li>
                  <label>
                    <input type="checkbox" class="filter-price" data-min="0" data-max="200000" />
                    <span>Dưới 200k</span>
                  </label>
                </li>
                <li>
                  <label>
                    <input type="checkbox" class="filter-price" data-min="200000" data-max="400000" />
                    <span>200k - 400k</span>
                  </label>
                </li>
                <li>
                  <label>
                    <input type="checkbox" class="filter-price" data-min="400000" data-max="1000000000" />
                    <span>Trên 400k</span>
                  </label>
                </li>
              </ul>
            </div>
            <div class="filter-section">
              <div class="filter-title">Size</div>
              <ul class="filter-list">
                <li><label><input type="checkbox" /> <span>S</span></label></li>
                <li><label><input type="checkbox" /> <span>M</span></label></li>
                <li><label><input type="checkbox" /> <span>L</span></label></li>
                <li><label><input type="checkbox" /> <span>XL</span></label></li>
              </ul>
            </div>
          </aside>

          <!-- Khối danh sách sản phẩm mới -->
          <section class="new-content">
            <div class="product-grid new-grid">
              <% if (products.length===0) { %>
                <div class="alert alert-warning">Chưa có sản phẩm nào.</div>
                <% } else { %>
                  <% products.forEach((product)=> { %>
                    <% const image=product.mainImage || (product.galleryImages && product.galleryImages[0]) || "" ; %>
                      <article class="product-card"
                        data-category="<%= product.category ? product.category.toString() : '' %>"
                        data-price="<%= product.price %>">
                        <div class="product-media">
                          <span class="product-badge product-badge--new">NEW</span>
                          <% if (image) { %>
                            <a href="/products/<%= product._id %>">
                              <img src="<%= image %>" alt="<%= product.name %>" />
                            </a>
                            <% } else { %>
                              <div class="media-placeholder">No image</div>
                              <% } %>
                                <% if (product.discountPercent> 0) { %>
                                  <span class="product-badge">-<%= product.discountPercent %>%</span>
                                  <% } %>
                        </div>
                        <div class="product-body">
                          <h2>
                            <a href="/products/<%= product._id %>">
                              <%= product.name %>
                            </a>
                          </h2>
                          <div class="product-price">
                            <% if (product.discountPercent> 0) { %>
                              <% const discounted=Math.round(product.price * (100 - product.discountPercent) / 100); %>
                                <span class="price-now">
                                  <%= discounted.toLocaleString("vi-VN") %> VND
                                </span>
                                <span class="price-old">
                                  <%= product.price.toLocaleString("vi-VN") %> VND
                                </span>
                                <% } else { %>
                                  <span class="price-now">
                                    <%= product.price.toLocaleString("vi-VN") %> VND
                                  </span>
                                  <% } %>
                          </div>
                        </div>
                      </article>
                      <% }) %>
                        <% } %>
            </div>
          </section>
        </div>
      </div>
    </main>

    <script>
      // Nhóm bộ lọc danh mục và giá
      const categoryInputs = document.querySelectorAll(".filter-category");
      const priceInputs = document.querySelectorAll(".filter-price");
      const productCards = document.querySelectorAll(".product-card");

      // Lấy danh sách danh mục được chọn
      const getSelectedCategories = () =>
        Array.from(categoryInputs)
          .filter((input) => input.checked)
          .map((input) => input.value);

      // Lấy danh sách khoảng giá được chọn
      const getSelectedPrices = () =>
        Array.from(priceInputs)
          .filter((input) => input.checked)
          .map((input) => ({
            min: Number(input.dataset.min),
            max: Number(input.dataset.max),
          }));

      // Kiểm tra giá có nằm trong khoảng không
      const matchesPrice = (price, ranges) => {
        if (ranges.length === 0) return true;
        return ranges.some((range) => price >= range.min && price < range.max);
      };

      // Áp dụng bộ lọc cho tất cả thẻ sản phẩm
      const applyFilters = () => {
        const selectedCategories = getSelectedCategories();
        const selectedPrices = getSelectedPrices();

        productCards.forEach((card) => {
          const cardCategory = card.dataset.category;
          const cardPrice = Number(card.dataset.price || 0);
          const matchCategory =
            selectedCategories.length === 0 || selectedCategories.includes(cardCategory);
          const matchPrice = matchesPrice(cardPrice, selectedPrices);
          card.style.display = matchCategory && matchPrice ? "" : "none";
        });
      };

      // Lắng nghe thay đổi bộ lọc
      categoryInputs.forEach((input) => input.addEventListener("change", applyFilters));
      priceInputs.forEach((input) => input.addEventListener("change", applyFilters));
    </script>

    <%- include("../partials/footer") %>
