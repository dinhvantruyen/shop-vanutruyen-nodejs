<script>
  // Lấy danh sách sản phẩm đã xem từ localStorage và render
  const recentlySection = document.querySelector("[data-recently-viewed]");
  if (recentlySection) {
    let items = [];
    try {
      items = JSON.parse(localStorage.getItem("recentlyViewed") || "[]");
    } catch (err) {
      items = [];
    }
    if (items.length) {
      const grid = recentlySection.querySelector(".recently-grid");
      grid.innerHTML = items
        .slice(0, 5)
        .map((item) => {
          // Format giá và ảnh hiển thị
          const price = item.price ? item.price.toLocaleString("vi-VN") + " VND" : "";
          const image = item.image || "";
          return `
            <a class="recently-card" href="/products/${item.id}">
              <span class="recently-thumb">
                ${image ? `<img src="${image}" alt="${item.name}">` : "<span></span>"}
              </span>
              <span class="recently-body">
                <span class="recently-name">${item.name}</span>
                <span class="recently-price">${price}</span>
              </span>
            </a>
          `;
        })
        .join("");
      recentlySection.hidden = false;
    }
  }
</script>
