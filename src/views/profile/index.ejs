<%- include("../partials/head", { title }) %>
  <%- include("../partials/header") %>

    <!-- Trang thông tin cá nhân -->
    <main class="container py-5">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h1 class="h4 mb-2">Thông tin cá nhân</h1>
          <p class="text-muted mb-3">Xem thông tin hiện tại và cập nhật tại trang địa chỉ.</p>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-dark" href="/profile">Thông tin cá nhân</a>
            <a class="btn btn-outline-dark" href="/profile/orders">Theo dõi đơn hàng</a>
            <a class="btn btn-outline-dark" href="/profile/password">Thay đổi mật khẩu</a>
            <a class="btn btn-outline-dark" href="/profile/address">Cập nhật địa chỉ</a>
          </div>
          <!-- Thông báo lỗi/thành công -->
          <% if (error) { %>
            <div class="alert alert-danger mt-3 mb-0">
              <%= error %>
            </div>
            <% } %>
              <% if (success) { %>
                <div class="alert alert-success mt-3 mb-0">
                  <%= success %>
                </div>
                <% } %>
        </div>
      </div>

      <!-- Hai cột thông tin: hiện tại và nhận hàng -->
      <div class="row g-4">
        <div class="col-12 col-lg-6">
          <!-- Thông tin hiện tại của tài khoản -->
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
              <h2 class="h6 text-uppercase text-muted">Thông tin hiện tại</h2>
              <div class="mt-3">
                <div><strong>Họ tên:</strong>
                  <%= user ? user.name : "-" %>
                </div>
                <div><strong>Email:</strong>
                  <%= user ? user.email : "-" %>
                </div>
                <div><strong>Số đơn hàng:</strong>
                  <%= user && typeof user.purchaseCount==="number" ? user.purchaseCount : 0 %>
                </div>
                <% if (user && typeof user.purchaseTotal==="number" && user.purchaseTotal> 0) { %>
                  <% } %>
                    <div><strong>Hạng thành viên:</strong>
                      <%= loyalty ? loyalty.level : "Đồng" %>
                    </div>
                    <div><strong>Điểm tích lũy:</strong>
                      <%= loyalty ? loyalty.points : 0 %>
                    </div>
                    <div class="text-muted mt-2">
                      <strong>Ngày tham gia:</strong>
                      <%= user && user.createdAt ? new Date(user.createdAt).toLocaleDateString("vi-VN") : "-" %>
                    </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <!-- Thông tin nhận hàng lấy từ trang địa chỉ -->
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
              <h2 class="h6 text-uppercase text-muted">Thông tin nhận hàng</h2>
              <div class="mt-3">
                <div><strong>Người nhận:</strong>
                  <%= user && user.receiverName ? user.receiverName : "-" %>
                </div>
                <div><strong>Số điện thoại:</strong>
                  <%= user && user.phone ? user.phone : "-" %>
                </div>
                <div><strong>Tỉnh/Thành phố:</strong>
                  <%= user && user.city ? user.city : "-" %>
                </div>
                <div><strong>Phường/Xã:</strong>
                  <%= user && user.ward ? user.ward : "-" %>
                </div>
                <div><strong>Địa chỉ:</strong>
                  <%= user && user.address ? user.address : "-" %>
                </div>
                <div class="text-muted mt-2">
                  Cập nhật thông tin nhận hàng tại trang địa chỉ.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../partials/footer") %>